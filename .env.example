# Пароль входа в панель (обязателен)
ADMIN_PASSWORD=
# Ключ шифрования токенов, SSH-ключа и ключей нод в data/db.json (обязателен): openssl rand -base64 32
# Храните копию отдельно от бэкапов data/: без него сохранённые секреты не восстановить
DATA_KEY=
# Адрес и порт сервера панели
HOST=127.0.0.1
PORT=8787
# Публичный адрес панели: из него собираются ссылки подписок (https://panel.example.com)
PUBLIC_URL=
# Ядро Taiga для Linux (по умолчанию из ~/taiga/resources/linux)
TAIGA_CORE=
# Каталог данных (по умолчанию ./data)
DATA_DIR=
# 1, если панель стоит за nginx/Caddy: адрес клиента берётся из X-Forwarded-For
# (в compose.yaml уже задано: панель за nginx)
TRUST_PROXY=0
# Домен панели для nginx и сертификата Let's Encrypt (panel.example.com); PUBLIC_URL тогда https://<домен>
DOMAIN=

# ---- Переопределение настроек панели ----
# Заданная здесь переменная важнее значения со страницы «Настройки» и шаблона синхронизации:
# поле на странице блокируется, а значение не сохраняется в data/db.json. Пустая переменная не считается.
# Изменения вступают в силу после перезапуска панели.

# Яндекс Диск: OAuth-токен и папка для документов (disk:/Taiga)
YANDEX_TOKEN=
YANDEX_DOCS_FOLDER=
# Remnawave: адрес панели и API-токен
REMNAWAVE_URL=
REMNAWAVE_TOKEN=
# SSH-ключ для нод: PEM с \n вместо переносов строк или весь файл ключа в base64 (base64 -w0 ~/.ssh/id_ed25519)
SSH_PRIVATE_KEY=
# ...или путь к файлу ключа (в Docker файл нужно смонтировать в контейнер)
SSH_PRIVATE_KEY_FILE=
SSH_PASSPHRASE=
SSH_USER=

# Синхронизация подписок с Remnawave: 1 включена, 0 выключена
REMNAWAVE_SYNC=
# Шаблон подписок пользователей Remnawave
SYNC_NAME=
SYNC_TELEGRAM=
SYNC_SITE=
# Сообщение: \n для переноса строки
SYNC_MESSAGE=
# Ноды через запятую: id или название ноды в панели
SYNC_NODES=
